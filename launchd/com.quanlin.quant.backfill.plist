<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quanlin.quant.backfill</string>

    <!-- 工作目录 -->
    <key>WorkingDirectory</key>
    <string>/Users/quanlin/Desktop/项目/AI量化/quant_db</string>

    <!-- 盘后回填基本面：申万行业 + 核心财务 + 三表明细 + 宏观（均增量：已有则跳过） -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>source .venv/bin/activate &amp;&amp; python3 -m data_ingest.industry &amp;&amp; python3 -m data_ingest.finance_adata &amp;&amp; python3 -m data_ingest.finance_statements &amp;&amp; python3 -m data_ingest.macro &amp;&amp; python3 -m data_ingest.announcement &gt;&gt; logs/backfill.out.log 2&gt;&amp;1</string>
    </array>

    <!-- 每天 18:30（收盘后、日常使用低峰）触发 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/quanlin/Desktop/项目/AI量化/quant_db/logs/backfill.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/quanlin/Desktop/项目/AI量化/quant_db/logs/backfill.err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <!-- 异常退出后自动重启（间隔 5 分钟） -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>ThrottleInterval</key>
        <integer>300</integer>
    </dict>
</dict>
</plist>
